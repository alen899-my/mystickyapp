# ── Database ────────────────────────────────────────────────────
# PostgreSQL (production) — get from Neon, Supabase, Railway, etc.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# SQLite (local dev only — uncomment and comment out above)
# DATABASE_URL="sqlite:///./mystickyapp.db"

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS="https://mystickyapp.vercel.app,http://localhost:5173"

# ── App ─────────────────────────────────────────────────────────
PORT=8000

# ── Auth ─────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your-super-secret-key-at-least-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days
